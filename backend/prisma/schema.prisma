// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  // Keep generated TypeScript inside rootDir so `tsc` can emit the server.
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String            @unique @db.VarChar(255)
  email            String            @unique @db.VarChar(255)
  passwordHash     String            @map("password_hash") @db.VarChar(255)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLogin        DateTime?         @map("last_login") @db.Timestamptz(6)

  users            User[]
  incidents        Incident[]
  incidentEvents   IncidentEvent[]
  incidentComments IncidentComment[]
  notifications    Notification[]

  @@map("organizations")
}

model User {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String            @map("org_id") @db.Uuid
  name              String            @db.VarChar(255)
  email             String            @unique @db.VarChar(255)
  passwordHash      String            @map("password_hash") @db.VarChar(255)
  role              String            @db.VarChar(20)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLogin         DateTime?         @map("last_login") @db.Timestamptz(6)

  organization      Organization      @relation(fields: [orgId], references: [id])
  createdIncidents  Incident[]        @relation("IncidentCreator")
  assignedIncidents Incident[]        @relation("IncidentAssignee")
  incidentEvents    IncidentEvent[]
  incidentComments  IncidentComment[]
  notifications     Notification[]

  @@index([orgId])
  @@map("users")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("Severity")
}

enum Status {
  OPEN
  INVESTIGATING
  MITIGATED
  RESOLVED

  @@map("Status")
}

enum IncidentEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  SEVERITY_CHANGED
  ASSIGNED
}

enum NotificationType {
  INCIDENT_CREATED
  INCIDENT_ASSIGNED
  INCIDENT_UPDATED
}

model Incident {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  title          String          @db.VarChar(255)
  description    String          @db.Text
  severity       Severity
  status         Status          @default(OPEN)
  createdBy      String          @map("created_by") @db.Uuid
  assignedTo     String?         @map("assigned_to") @db.Uuid
  version        Int             @default(1)
  idempotencyKey String?         @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [id])
  creator      User            @relation("IncidentCreator", fields: [createdBy], references: [id])
  assignee     User?           @relation("IncidentAssignee", fields: [assignedTo], references: [id])

  events        IncidentEvent[]
  comments      IncidentComment[]
  notifications Notification[]

  @@index([orgId, status, createdAt])
  @@index([orgId, severity])
  @@index([orgId, assignedTo])
  @@unique([orgId, idempotencyKey])
  @@map("incidents")
}

model IncidentEvent {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId String            @map("incident_id") @db.Uuid
  orgId      String            @map("org_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  type       IncidentEventType
  message    String?           @db.Text
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  // Cascade delete when the parent incident is deleted
  incident     Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [orgId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  notifications Notification[]

  @@index([incidentId, createdAt])
  @@index([incidentId, userId, createdAt])
  @@index([orgId, createdAt])
  @@map("incident_events")
}

model IncidentComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Cascade delete when the parent incident is deleted
  incident     Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [orgId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@index([incidentId, createdAt])
  @@index([orgId, createdAt])
  @@map("incident_comments")
}

model Notification {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String           @map("org_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  incidentId     String           @map("incident_id") @db.Uuid
  incidentEventId String          @map("incident_event_id") @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(255)
  message        String           @db.Text
  readAt         DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  incident      Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentEvent IncidentEvent @relation(fields: [incidentEventId], references: [id], onDelete: Cascade)

  // One user can receive only one notification for a specific incident event.
  @@unique([incidentEventId, userId])

  @@index([userId, readAt, createdAt])
  @@index([orgId, createdAt])
  @@index([incidentId, createdAt])
  @@map("notifications")
}

